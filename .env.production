# Production Environment Configuration
#
# This file is copied to backend/.env by `npm run prod` / `node manager.js prod`.
# Uncomment any commented setting to enable it; values shown after `=` are the
# in-code defaults.

# --- Core ---
PORT=3002
DB_PATH=/var/data/workflow.db
PYTHON_CMD=python3
NODE_ENV=production
# LOG_LEVEL=info               # pino level: trace|debug|info|warn|error|fatal

# --- Default AI provider (seeded into the DB on first start) ---
# Once seeded, the AI Providers settings page is the source of truth. Editing
# these vars later only affects fresh installs.
# VLLM_BASE_URL=http://vllm:8000/v1
# VLLM_DEFAULT_MODEL=Qwen2.5-VL-7B-Instruct
# VLLM_API_KEY=
# VLLM_SUPPORTS_VISION=false

# --- AI assistant tuning ---
# Override which provider the chat assistant uses (otherwise falls back to the
# default provider). Prefer setting `assistant_provider_id` via the API.
# ASSISTANT_PROVIDER_ID=
# ASSISTANT_CONTEXT_WINDOW=8192        # token budget before auto-compaction
# ASSISTANT_MAX_TOOL_ITERATIONS=8      # tool-loop ceiling per turn
# ASSISTANT_TOOL_RESULT_MAX_CHARS=7000 # per-tool-result truncation

# --- Workflow execution ---
# HTTP_ALLOWLIST=                       # comma-separated hosts/CIDRs for http-request; loopback-only by default
# MAX_CONCURRENT_NODES=4                # parallel node cap inside one v2 execution
# UPLOADS_DIR=/var/data/uploads         # where uploaded files & rasterized images live
# IMAGE_LONG_SIDE_PX=1568               # max long-side for rasterized PDF pages

# --- Feature flags ---
# OFFLINE_MODE=false                    # `true` hides slack/email node types in the editor palette
# LOAD_EXAMPLE_QUIZ_WORKFLOW=true       # `false` skips seeding the Document Quiz Generator example
# CORS_ORIGINS=                         # comma-separated origins; empty = allow all — restrict in prod

# --- SMTP (optional; email step fails gracefully if unset) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user
SMTP_PASS=pass
SMTP_FROM=no-reply@localhost
